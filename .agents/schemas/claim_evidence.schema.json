{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Runtime-only source/claim ledger. Never copied into final video folder.",
  "title": "claim evidence ledger",
  "type": "object",
  "required": [
    "mode",
    "topic",
    "claims"
  ],
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "1",
        "2"
      ]
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "statement",
          "claim_type",
          "certainty",
          "decision",
          "allowed_wording",
          "visual_rule",
          "sources"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "claim_type": {
            "type": "string",
            "enum": [
              "fact",
              "number",
              "date",
              "institution",
              "causation",
              "absence",
              "historical_reconstruction",
              "hypothesis"
            ]
          },
          "certainty": {
            "type": "string",
            "enum": [
              "established",
              "supported",
              "preliminary",
              "disputed",
              "hypothetical",
              "unknown"
            ]
          },
          "decision": {
            "type": "string",
            "enum": [
              "verified",
              "qualified",
              "speculative",
              "reject"
            ]
          },
          "allowed_wording": {
            "type": "string",
            "minLength": 1
          },
          "visual_rule": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "url",
                "source_type",
                "supports"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1
                },
                "source_type": {
                  "type": "string",
                  "enum": [
                    "primary",
                    "authoritative",
                    "peer_reviewed",
                    "reputable_secondary",
                    "community_signal"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "published_date": {
                  "type": "string"
                },
                "supports": {
                  "type": "string",
                  "minLength": 8,
                  "description": "Concrete note describing exactly which part of this claim the source supports; never leave as a bare URL."
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
