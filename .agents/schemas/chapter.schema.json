{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "tools/schema_validator.py implements the project-used draft-07 subset: type, const, enum, required, properties, additionalProperties, items, minLength, maxLength, minimum, maximum, pattern, minItems, maxItems, uniqueItems, allOf with simple if/then.",
  "title": "chapter_[n].json",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "scene",
      "voiceover",
      "sub",
      "context_ref",
      "sentence_id",
      "part",
      "continuity_ref",
      "shot_type",
      "veo_prompt"
    ],
    "properties": {
      "scene": {
        "type": "integer",
        "minimum": 1
      },
      "voiceover": {
        "type": "string",
        "minLength": 1
      },
      "sub": {
        "type": "string",
        "minLength": 1
      },
      "context_ref": {
        "type": "string",
        "minLength": 1
      },
      "sentence_id": {
        "type": "integer",
        "minimum": 1
      },
      "part": {
        "type": "string",
        "pattern": "^[0-9]+/[0-9]+$"
      },
      "continuity_ref": {
        "type": "string",
        "minLength": 1
      },
      "shot_type": {
        "type": "string",
        "enum": [
          "establishing",
          "extreme-wide",
          "wide",
          "medium",
          "medium-close-up",
          "close-up",
          "extreme-close-up",
          "two-shot",
          "over-the-shoulder",
          "insert",
          "tracking",
          "POV",
          "pan",
          "tilt",
          "whip-pan",
          "static",
          "handheld",
          "steadicam",
          "aerial",
          "drone",
          "dolly",
          "dolly-zoom",
          "crane",
          "arc",
          "overhead",
          "low-angle",
          "high-angle",
          "birds-eye",
          "worms-eye",
          "dutch-angle"
        ]
      },
      "veo_prompt": {
        "type": "string",
        "minLength": 900,
        "maxLength": 4000,
        "description": "Production-quality Veo prompt: English, visual-only, exactly one continuous shot, richly detailed and narration-faithful. Project quality floor 900 Unicode characters total; hard ceiling 4000. Deterministic QA separately requires >=800 characters before the Negative clause."
      },
      "timeline": {
        "type": "object",
        "required": [
          "start",
          "end",
          "duration",
          "start_formatted",
          "end_formatted",
          "speed"
        ],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "duration": {
            "type": "number",
            "minimum": 0
          },
          "start_formatted": {
            "type": "string",
            "pattern": "^\\d{2,}:\\d{2}\\.\\d{3}$"
          },
          "end_formatted": {
            "type": "string",
            "pattern": "^\\d{2,}:\\d{2}\\.\\d{3}$"
          },
          "speed": {
            "type": "number",
            "minimum": 0.1
          }
        },
        "additionalProperties": false,
        "description": "Audio timeline mapping for scene synchronization. Schema validates field shape; deterministic QA additionally enforces monotonic/contiguous start-end boundaries, duration=end-start, formatted-time consistency, and valid speed."
      }
    },
    "additionalProperties": false
  }
}
